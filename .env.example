# Copy this file to .env and replace the credentials.
PANEL_LOGIN_USERNAME="your-tci-username"
PANEL_LOGIN_PASSWORD="your-tci-password"

# Optional collector settings:
PANEL_BASE_URL="https://internet.tci.ir"
PANEL_REQUEST_TIMEOUT="10"
# Use an absolute path on PHP-FPM deployments. Leave unset for ./dataset.
# OCR_DATASET_DIR="/srv/tci-ocr/dataset"
